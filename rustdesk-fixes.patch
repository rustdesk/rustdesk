+  PROJECT_NAME: "rustdesk"
 
 on:
   workflow_dispatch:
@@ -25,18 +26,40 @@ on:
       - "flatpak/**"
 
 jobs:
-  # ensure_cargo_fmt:
-  #   name: Ensure 'cargo fmt' has been run
-  #   runs-on: ubuntu-20.04
-  #   steps:
-  #   - uses: actions-rs/toolchain@16499b5e05bf2e26879000db0c1d13f7e13fa3af # v1
-  #     with:
-  #       toolchain: stable
-  #       default: true
-  #       profile: minimal
-  #       components: rustfmt
-  #   - uses: actions/checkout@f43a0e5ff2bd294095638e18286ca9a3d1956744 # v3
-  #   - run: cargo fmt -- --check
+  ensure_cargo_fmt:
+    name: Ensure 'cargo fmt' has been run
+    runs-on: ubuntu-24.04
+    steps:
+    - name: Checkout source code
+      uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
+      with:
+        submodules: recursive
+    - name: Install Rust toolchain
+      uses: dtolnay/rust-toolchain@e97e2d8cc328f1b50210efc529dca0028893a2d9 # v1
+      with:
+        toolchain: stable
+        components: rustfmt
+    - name: Run cargo fmt
+      run: cargo fmt --all -- --check
+
+  cargo_audit:
+    name: Check RustSec advisories (cargo audit)
+    runs-on: ubuntu-24.04
+    continue-on-error: true
+    steps:
+    - name: Checkout source code
+      uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
+      with:
+        submodules: recursive
+    - name: Install Rust toolchain
+      uses: dtolnay/rust-toolchain@e97e2d8cc328f1b50210efc529dca0028893a2d9 # v1
+      with:
+        toolchain: stable
+    - name: Run cargo audit
+      continue-on-error: true
+      run: |
+        cargo install cargo-audit --locked
+        cargo audit
 
   # min_version:
   #   name: Minimum supported rust version
@@ -181,6 +204,13 @@ jobs:
         command: build
         args: --locked --target=${{ matrix.job.target }}
 
+    - name: Run clippy
+      continue-on-error: true
+      shell: bash
+      run: |
+        rustup component add clippy
+        cargo clippy --locked --target=${{ matrix.job.target }} --workspace --all-targets
+
     - name: clean
       shell: bash
       run: |
diff --git a/.github/workflows/flutter-ci.yml b/.github/workflows/flutter-ci.yml
index a64dd11..8b06940 100644
--- a/.github/workflows/flutter-ci.yml
+++ b/.github/workflows/flutter-ci.yml
@@ -22,3 +22,31 @@ jobs:
     uses: ./.github/workflows/flutter-build.yml
     with:
       upload-artifact: false
+
+  flutter-analyze:
+    name: flutter analyze / flutter test
+    runs-on: ubuntu-24.04
+    continue-on-error: true
+    steps:
+      - name: Checkout source code
+        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4
+
+      - name: Install flutter
+        uses: subosito/flutter-action@1a449444c387b1966244ae4d4f8c696479add0b2 # v2
+        with:
+          channel: "stable"
+          flutter-version: "3.24.5" # keep in sync with FLUTTER_VERSION in flutter-build.yml
+
+      - name: flutter pub get
+        working-directory: flutter
+        run: flutter pub get
+
+      - name: flutter analyze
+        continue-on-error: true
+        working-directory: flutter
+        run: flutter analyze
+
+      - name: flutter test
+        continue-on-error: true
+        working-directory: flutter
+        run: flutter test
