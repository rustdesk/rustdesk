+void SetPrivacyCursorHidden(bool hidden)
+{
+	if (hidden && !g_cursor_magnification_initialized)
+	{
+		if (!MagInitialize())
+		{
+			DebugLogLastError(_T("MagInitialize"));
+			return;
+		}
+		g_cursor_magnification_initialized = true;
+	}
+	if (!g_cursor_magnification_initialized)
+	{
+		return;
+	}
+	// Suppress local rendering without changing cursor shape, position or input routing.
+	if (!MagShowSystemCursor(hidden ? FALSE : TRUE))
+	{
+		DebugLogLastError(_T("MagShowSystemCursor"));
+		return;
+	}
+	if (!hidden)
+	{
+		if (!MagUninitialize())
+		{
+			DebugLogLastError(_T("MagUninitialize"));
+			return;
+		}
+		g_cursor_magnification_initialized = false;
+	}
+}
+
+bool IsPrivacyDesktopActive()
+{
+	BOOL active = FALSE;
+	if (!GetUserObjectInformationW(GetThreadDesktop(GetCurrentThreadId()),
+		UOI_IO, &active, sizeof(active), nullptr))
+	{
+		DebugLogLastError(_T("GetUserObjectInformationW(UOI_IO)"));
+		return false;
+	}
+	return active != FALSE;
+}
+
+void ReloadPrivacyBackground()
+{
+	if (g_module == nullptr)
+	{
+		return;
+	}
+	wchar_t module_path[MAX_PATH] = {};
+	if (GetModuleFileNameW(g_module, module_path, ARRAYSIZE(module_path)) == 0)
+	{
+		return;
+	}
+	std::wstring directory(module_path);
+	const auto separator = directory.find_last_of(L"\\/");
+	if (separator == std::wstring::npos)
+	{
+		return;
+	}
+	directory.resize(separator);
+	g_privacyBackground.Reload(directory);
+	g_privacy_background_initialized = true;
+	for (auto window : g_hwnds)
+	{
+		InvalidateRect(window, nullptr, TRUE);
+	}
+}
