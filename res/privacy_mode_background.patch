+bool IsSessionLocked()
+{
+	PWTSINFOEXW info = nullptr;
+	DWORD bytes = 0;
+	if (WTSQuerySessionInformationW(
+		WTS_CURRENT_SERVER_HANDLE,
+		WTS_CURRENT_SESSION,
+		WTSSessionInfoEx,
+		reinterpret_cast<LPWSTR*>(&info),
+		&bytes) == FALSE)
+	{
+		return false;
+	}
+
+	const bool locked = info != nullptr
+		&& info->Level == 1
+		&& info->Data.WTSInfoExLevel1.SessionFlags == WTS_SESSIONSTATE_LOCK;
+	if (info != nullptr)
+	{
+		WTSFreeMemory(info);
+	}
+	return locked;
+}
