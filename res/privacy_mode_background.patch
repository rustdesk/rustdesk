+PrivacyBackground g_privacyBackground;
+std::map<HWND, std::unique_ptr<PrivacyTaskbar>> g_privacyTaskbars;
+
+void RemovePrivacyTaskbar(HWND hwnd)
+{
+	KillTimer(hwnd, PRIVACY_TASKBAR_TIMER);
+	g_privacyTaskbars.erase(hwnd);
+}
+
+void UpdatePrivacyTaskbar(HWND hwnd)
+{
+	if (!g_privacyBackground.ShowsTaskbar() || !IsWindowVisible(hwnd))
+	{
+		RemovePrivacyTaskbar(hwnd);
+		return;
+	}
+	auto& taskbar = g_privacyTaskbars[hwnd];
+	if (!taskbar)
+	{
+		taskbar = std::make_unique<PrivacyTaskbar>();
+		// DWM updates the pixels. Poll only to handle shell restarts and geometry.
+		SetTimer(hwnd, PRIVACY_TASKBAR_TIMER, 1000, nullptr);
+	}
+	taskbar->Update(hwnd);
+}
