+PrivacyBackground g_background;
+
+void ReloadPrivacyBackground()
+{
+	std::vector<wchar_t> path(32768);
+	const auto length = GetModuleFileNameW(g_module, path.data(), static_cast<DWORD>(path.size()));
+	if (length == 0 || length >= path.size())
+	{
+		OutputDebugStringW(L"RustDesk: cannot locate privacy background configuration.\n");
+		return;
+	}
+	const std::wstring filename(path.data(), length);
+	const auto separator = filename.find_last_of(L"\\/");
+	if (separator != std::wstring::npos)
+	{
+		g_background.Reload(filename.substr(0, separator));
+	}
+}
 
