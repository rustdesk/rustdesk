#!/bin/sh
set -e

install -d /usr/bin
ln -sf /usr/share/@PKG@/@BIN@ /usr/bin/@BIN@

install -d /usr/share/applications
cp /usr/share/@PKG@/files/@PKG@.desktop /usr/share/applications/
update-desktop-database >/dev/null 2>&1 || true

install -d /etc/systemd/system
cp /usr/share/@PKG@/files/@PKG@.service /etc/systemd/system/
systemctl daemon-reload || true
systemctl enable @PKG@.service || true
systemctl restart @PKG@.service || true

exit 0
