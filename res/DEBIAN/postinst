#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/remotefocus/remotefocus /usr/bin/remotefocus

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/remotefocus.service ]; then
			rm /etc/systemd/system/remotefocus.service /usr/lib/systemd/system/remotefocus.service /usr/lib/systemd/user/remotefocus.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/remotefocus/files/systemd/remotefocus.service /usr/lib/systemd/system/remotefocus.service
		# try fix error in Ubuntu 18.04
		# Failed to reload remotefocus.service: Unit remotefocus.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/remotefocus.service:10: Executable path is not absolute: pkill -f "remotefocus --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/remotefocus.service
		fi
		systemctl daemon-reload
		systemctl enable remotefocus
		systemctl start remotefocus
	fi
fi
