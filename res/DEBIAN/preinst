#!/bin/bash

set -e

case $1 in
    install|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		if [ "systemd" == "${INITSYS}" ]; then
			service rustdesk stop || true
      sleep 1
      rm -rf /usr/bin/libsciter-gtk.so
		fi
        ;;
esac

if [ "$1" = upgrade ]; then
    # A desktop-launched GUI can survive the service stop. The old prerm removes /usr/bin/rustdesk.
    for pid in $(pgrep -fx '([^ ]*/)?rustdesk( rustdesk://[^ ]*)?'); do
        [ "/proc/$pid/exe" -ef /usr/share/rustdesk/rustdesk ] || continue
        kill -TERM "$pid" || [ ! -d "/proc/$pid" ] || exit 1
    done
fi

exit 0
