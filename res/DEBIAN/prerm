#!/bin/bash

set -e

case $1 in
    remove|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		rm -f /usr/bin/rustdesk
		
		if [ "systemd" == "${INITSYS}" ]; then

			systemctl stop rustdesk || true
			systemctl disable rustdesk || true
			rm -f /etc/systemd/system/rustdesk.service /usr/lib/systemd/system/rustdesk.service || true
			
			# workaround temp dev build between 1.1.9 and 1.2.0
			# several sessions may each run their own `rustdesk --server`; stop the
			# user unit for every distinct non-root owner, not just the first one
			for serverUser in $( { pgrep -f 'rustdesk +--server' 2>/dev/null | xargs -r ps -o user= -p 2>/dev/null; } | grep -v '^root$' | sort -u || true)
			do
				systemctl --machine=${serverUser}@.host --user stop rustdesk >/dev/null 2>&1 || true
			done
			rm -f /usr/lib/systemd/user/rustdesk.service >/dev/null 2>&1 || true
		fi
        ;;
esac

exit 0
